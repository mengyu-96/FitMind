FITMIND_ENVIRONMENT=development
# Local development only. Never expose this login route to the Internet.
FITMIND_DEV_LOGIN_ENABLED=false
FITMIND_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/fitmind
# deepseek | qwen | doubao | zhipu | moonshot | custom
# Provider names are labels. Base URL/model must match the account's API service.
FITMIND_MODEL_PROVIDER=deepseek
FITMIND_MODEL_BASE_URL=https://api.deepseek.com
FITMIND_MODEL_NAME=deepseek-flash
FITMIND_MODEL_API_KEY=
